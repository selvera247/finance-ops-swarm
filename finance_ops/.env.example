GOOGLE_API_KEY=
FINANCE_OPS_MODEL=gemini-3.1-flash-lite
FINANCE_OPS_DATA_MODE=warehouse
FINANCE_OPS_USE_BIGQUERY=false
GOOGLE_CLOUD_PROJECT=
FINANCE_OPS_BQ_DATASET=finance_ops
# L4 vectors
FINANCE_OPS_USE_VERTEX_VECTORS=false
FINANCE_OPS_VERTEX_LOCATION=us-central1
FINANCE_OPS_EMBEDDING_MODEL=text-embedding-004
FINANCE_OPS_VECTOR_INDEX_ENDPOINT=
FINANCE_OPS_VECTOR_DEPLOYED_INDEX_ID=finance_ops_policies
# L5 graph: duckdb | sqlite | neo4j | spanner
FINANCE_OPS_GRAPH_BACKEND=duckdb
FINANCE_OPS_GRAPH_SQLITE=
SPANNER_INSTANCE=
SPANNER_DATABASE=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=financeops
# L6 serve: http (FastAPI) | adk (ADK api_server on same image)
FINANCE_OPS_SERVE_MODE=http
LEGACY_PORTAL_USER=analyst
LEGACY_PORTAL_PASS=demo123
# Slack HITL (#8)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_HITL_CHANNEL=
HITL_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Governance policy-as-code (D2) — defaults in finance_ops/governance/policy.yaml
FINANCE_OPS_POLICY_PATH=
FINANCE_OPS_POLICY_AUTO_ALLOW_MAX=
FINANCE_OPS_POLICY_REQUIRE_HUMAN_ABOVE=
FINANCE_OPS_POLICY_DENY_ABOVE=
# Agent registry seed (D3)
FINANCE_OPS_REGISTRY_PATH=
# HTTP auth for /v1/governance/* (Cloud Scheduler). Required for sweep — fail closed if unset.
FINANCE_OPS_GOVERNANCE_TOKEN=
# Ship governance audit JSONL rows to BigQuery table finance_ops.governance_audit
FINANCE_OPS_AUDIT_BQ=false
# HubSpot private app (read-mostly). Never commit the token. Webhook sig needs client secret.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_API_BASE=https://api.hubapi.com
